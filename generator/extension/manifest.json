{
  "manifest_version": 3,
  "name": "Genarator E-Perangkat",
  "version": "1.0.4",
  "description": "Unduh PDF E-Perangkat melalui mesin cetak Chrome dengan data, font, dan halaman cetak Production terbaru.",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "https://e-perangkat-online-a-f.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://genarator-e-perangkat.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Genarator E-Perangkat"
  }
}
